{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "builder": {
      "type": "swc",
      "options": { "ignore": ["**/*.test.ts"] }
    },
    "typeCheck": false,
    "deleteOutDir": true
  }
}
