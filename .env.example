# Copy to `.env` for development. `.env` is never committed.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://labsafe:labsafe@localhost:5442/labsafe
# Folder of the built web app; set only in test and production.
# WEB_DIST_DIR=
# `Secure` on the session cookie: true or false. Unset: true only when NODE_ENV=production.
# COOKIE_SECURE=
# The first admin, created at start-up when no admin exists: all three or none. Without them and
# without an admin, the app starts and logs a warning. Use your own values; never commit them.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
BOOTSTRAP_ADMIN_NAME=Lab Admin
