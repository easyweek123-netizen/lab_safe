{
  "name": "labsafe",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "concurrently -k \"pnpm:dev:*\"",
    "dev:shared": "pnpm --filter @labsafe/shared dev",
    "dev:api": "pnpm --filter @labsafe/api dev",
    "dev:web": "pnpm --filter @labsafe/web dev",
    "typecheck": "pnpm --filter @labsafe/shared build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:int": "pnpm --filter @labsafe/api test:int",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "db:up": "docker compose up -d --wait db db-test",
    "db:down": "docker compose stop db db-test",
    "db:migrate": "pnpm --filter @labsafe/api db:migrate",
    "test:db:prepare": "pnpm --filter @labsafe/api test:db:prepare",
    "docs:check": "node .claude/tools/docs-check.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:int && pnpm build && pnpm docs:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
